{
  "expo": {
    "name": "FirstDay Go",
    "slug": "firstday-go",
    "version": "1.0.0",
    "scheme": "firstdaygo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#161616"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.firstdaygo.app"
    },
    "android": {
      "package": "com.firstdaygo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161616"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
