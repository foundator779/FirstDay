// Writes docs/BEE_LIVE.md: evidence that FirstDay Go ran on your real Bee data. Counts only, no words
// (titles appear only for the conversations you list with --show, e.g. your fictional demo scripts).
// Read-only: it never writes to Bee. Needs the Bee CLI installed and signed in (`bee status`).
//
//   npm run bee:evidence                          # up to 40 recent processed conversations
//   npm run bee:evidence -- --max 80 --show 1234,1240
import { execFileSync } from "node:child_process";
import { writeFileSync } from "node:fs";
// @ts-ignore - the brain's Bee code is plain JS (the same calls the app makes through the brain)
import * as bee from "../brain/bee.mjs";
import { analyzeLocally } from "../src/logic/analyze";

type Row = { id: string; title: string; at: number; ready: boolean };
const arg = (name: string) => {
  const i = process.argv.indexOf(`--${name}`);
  return i >= 0 ? process.argv[i + 1] : undefined;
};
const max = Math.max(1, Math.min(200, Number(arg("max") ?? 40) || 40));
const show = new Set((arg("show") ?? "").split(",").map((s) => s.trim()).filter(Boolean));
const day = (t: number) => new Date(t).toISOString().slice(0, 10);

function cliVersion(): string {
  try {
    const cmd = process.env.BEE_CLI_PATH || "bee";
    return execFileSync(cmd, ["--version"], { encoding: "utf8", shell: process.platform === "win32", timeout: 15_000 }).trim().split("\n")[0] ?? "";
  } catch {
    return "unknown";
  }
}

const started = Date.now();
const list: Row[] = await bee.listConversations(Math.min(100, Math.max(max, 25)));
const ready = list.filter((c) => c.ready).slice(0, max);
const rows: { id: string; date: string; lines: number; speakers: number; steps: number; questions: number; title: string }[] = [];
let failed = 0;
for (const c of ready) {
  try {
    const full = await bee.getConversation(c.id);
    const lines: string[] = full.text.split("\n").filter(Boolean);
    const speakers = new Set(lines.map((l) => l.split(":")[0])).size;
    const a = analyzeLocally(full.text, Date.now());
    rows.push({ id: c.id, date: day(full.at), lines: lines.length, speakers, steps: a.rules.length, questions: a.questions.length, title: show.has(c.id) ? full.title : "" });
  } catch {
    failed++;
  }
}
const snap = await bee.syncSnapshot();
const days = new Set(rows.map((r) => r.date));
const sum = (k: "lines" | "steps" | "questions") => rows.reduce((n, r) => n + r[k], 0);
const withSteps = rows.filter((r) => r.steps > 0).length;
const count = (x: unknown[] | null) => (x ? String(x.length) : "couldn't read");

const md = `# Real Bee data: evidence

Generated by \`npm run bee:evidence\` on ${new Date(started).toISOString()} with ${cliVersion()}.
Read-only. Counts only: no transcript text, facts or to-do wording is written here${show.size ? " (titles only for the conversations listed with --show)" : ""}.

## What the Bee CLI returned

| | |
|---|---|
| Conversations listed | ${list.length} (${list.filter((c) => c.ready).length} processed, ${list.filter((c) => !c.ready).length} still processing) |
| Read in full for this check | ${rows.length}${failed ? ` (${failed} couldn't be read)` : ""} |
| Days covered | ${days.size}${days.size ? ` (${[...days].sort()[0]} to ${[...days].sort().at(-1)})` : ""} |
| Transcript lines (final, not realtime) | ${sum("lines")} |
| Facts | ${count(snap.facts)} |
| To-dos | ${count(snap.todos)} |
| To-do suggestions | ${count(snap.suggestions)} |
| Daily summary | ${snap.daily ? "yes" : "none"} |
| Insights | ${count(snap.insights)} |

## What FirstDay Go found in them (on-phone reader, no AI)

| | |
|---|---|
| Conversations with at least one work step | ${withSteps} of ${rows.length} |
| Work steps found (waiting for your confirmation) | ${sum("steps")} |
| Vague lines turned into questions for the trainer | ${sum("questions")} |

Everyday conversations rightly have no work steps; trainings do. Signed in, the app reads captures with Amazon Bedrock instead,
which finds more (see "How accurate it is" in the README).

## Per conversation

| Conversation | Date | Lines | Speakers | Work steps | Questions |
|---|---|---|---|---|---|
${rows.map((r, i) => `| ${r.title ? r.title.replace(/\|/g, "/") : `#${i + 1}`} | ${r.date} | ${r.lines} | ${r.speakers} | ${r.steps} | ${r.questions} |`).join("\n")}
`;

const out = new URL("../../docs/BEE_LIVE.md", import.meta.url);
writeFileSync(out, md);
console.log(`Wrote docs/BEE_LIVE.md: ${rows.length} conversations, ${sum("lines")} lines, ${sum("steps")} work steps found.`);
console.log("Also worth recording by hand in the video: a fix made in FirstDay Go showing up in the Bee app, and the live 'Just recorded by Bee' card.");
