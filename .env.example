# Safe local defaults. Copy this file to .env and keep credentials out of Git.
NODE_ENV=development
FIRSTDAY_DATA_MODE=fixture
FIRSTDAY_API_HOST=127.0.0.1
FIRSTDAY_API_PORT=3000
FIRSTDAY_API_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Public development-only session for fixture mode. It is accepted only when
# NODE_ENV is not production and cannot access live Bee sources.
FIRSTDAY_DEMO_SESSION_TOKEN=firstday-public-fixture-session
FIRSTDAY_DEMO_LEARNER_ID=70000000-0000-4000-8000-000000000001

# The Bee bridge always binds to 127.0.0.1 and is reachable only by the local
# FirstDay API process. Generate a unique token with at least 32 characters.
FIRSTDAY_BEE_BRIDGE_PORT=3100
FIRSTDAY_BEE_BRIDGE_TOKEN=
BEE_CLI_PATH=bee

# Only EXPO_PUBLIC_* values are bundled into the mobile app. Never add Bee or
# Supabase service-role credentials with this prefix.
EXPO_PUBLIC_FIRSTDAY_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_FIRSTDAY_DATA_MODE=fixture
EXPO_PUBLIC_FIRSTDAY_SESSION_TOKEN=firstday-public-fixture-session

# Live mode requires Supabase Auth and durable storage. Migrate an isolated
# FirstDay project before starting. Fixture mode defaults to session-only memory;
# set FIRSTDAY_STORAGE_MODE=supabase with a loopback endpoint to validate isolated
# durable fixture data. The public demo session cannot use hosted storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend-only AI provider. Source fixture mode can still call real Bedrock.
FIRSTDAY_AI_PROVIDER=fixture
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Set by demo:bedrock to route fixture requests through the API.
EXPO_PUBLIC_FIRSTDAY_AI_MODE=offline
# Optional isolated API fixture validation without Bedrock inference.
EXPO_PUBLIC_FIRSTDAY_API_MODE=local

# Live launcher: set these only in the ignored private environment.
# npm run demo:live -- --env-file=/absolute/private.env --check
# Then remove --check to start loopback bridge/API and the web sign-in screen.
# FIRSTDAY_DATA_MODE=live
# FIRSTDAY_STORAGE_MODE=supabase
# FIRSTDAY_AI_PROVIDER=bedrock
FIRSTDAY_BEE_OWNER_ID=
FIRSTDAY_MOBILE_API_URL=
FIRSTDAY_EXPO_PORT=8087
# Genuine owned local Supabase HTTP needs BOTH development and this opt-in.
FIRSTDAY_ALLOW_LOCAL_SUPABASE_HTTP=0
# Desktop/simulator loopback API HTTP only. Physical phones need trusted private HTTPS.
FIRSTDAY_ALLOW_LOOPBACK_API_HTTP=0
# Live access/refresh tokens are obtained by sign-in and kept only in RAM.
# EXPO_PUBLIC_FIRSTDAY_SESSION_TOKEN above is for fictional fixture mode only.
